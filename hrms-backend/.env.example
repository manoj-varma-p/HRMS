NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# MongoDB Atlas connection string (Phase 2)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hrms

# JWT secrets (Phase 2) - generate strong random values, never commit real ones
JWT_ACCESS_SECRET=replace-with-strong-random-value
JWT_REFRESH_SECRET=replace-with-strong-random-value

# 32-byte (64 hex char) key for encrypting stored SMTP/SES credentials (Phase 9)
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONFIG_ENCRYPTION_KEY=replace-with-a-64-char-hex-string

# Bootstrap Super Admin (used once by `npm run seed:super-admin`)
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
SUPER_ADMIN_EMPLOYEE_ID=SA-0001

# S3 document storage (Phase 10A). Optional — document upload/download
# returns a clear 503 if unset, the rest of the app is unaffected.
# SES credentials are NOT here; they're configured in-app under
# Administration > Email Settings (encrypted, reuses Phase 9 Configuration).
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace-with-an-iam-access-key
AWS_SECRET_ACCESS_KEY=replace-with-an-iam-secret-key
S3_BUCKET_NAME=replace-with-your-bucket-name
